# Create a token at https://platform.priorlabs.ai/account/api-keys
TABPFN_TOKEN=
# Hosted model variant: v3.5 or v3.5-fast
SNAKE_MODEL_VERSION=v3.5-fast
# Minimum seconds between hosted API calls. Raise it if your account hits rate limits.
SNAKE_API_INTERVAL=0
# Seconds before a hosted request times out (the client retries once).
SNAKE_API_TIMEOUT=20
